{
  "name": "@zzyyyds88/dsh-task-suite-all",
  "description": "DSH Web UI 精选聚合插件（自 dsh-web-ui 抽取，scope @zzyyyds88）：一键安装任务看板 / Git 图谱 / 右侧面板 / 实时令牌与吞吐统计 / 设置中心 / 皮肤中心与皮肤全家桶（含 maid-atelier）。compat 桥接层已并入本包（src/client），无需独立 compat npm 包。",
  "version": "0.1.17",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web-ui.git"
  },
  "dependencies": {
    "@zzyyyds88/dsh-client-ui-aionui-panel": "workspace:*",
    "@zzyyyds88/dsh-client-ui-task-board": "workspace:*",
    "@zzyyyds88/dsh-client-ui-git-graph": "workspace:*",
    "@zzyyyds88/dsh-live-stats": "workspace:*",
    "@zzyyyds88/dsh-client-ui-web-ui-settings": "workspace:*",
    "@zzyyyds88/dsh-skins": "workspace:*",
    "@zzyyyds88/dsh-client-ui-skin-center": "workspace:*"
  }
}
