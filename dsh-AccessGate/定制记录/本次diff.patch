+#!/usr/bin/env bash
+# restore-formal-auth.sh —— 把正式 profile 的鉴权恢复为旧版「全网监听与登录鉴权」状态
+#
+# 起因：2026-08-16 开发「访问门禁」插件时，install-access-gate-plugin.mjs 的
+# 参数解析 bug（只支持 --flag=value，不支持 --flag value）导致 --profile-dir /
+# --dsh-home 未生效，误把新插件与 patch 写进了正式 profile（/root/.dsh/profiles/web）：
+#   1) cordis.patch.yml 的 insert 里被追加了 access-gate / ui-access-gate 两行；
+#   2) 旧插件目录 dsh-web-auth / dsh-client-ui-web-auth 被删除。
+# settings.yaml 未被动（口令仍在 web-auth 键下）。
+#
+# 本脚本精确还原上述两处改动（不触碰 settings.yaml、不触碰 .bak、不触碰其它 patch 条目）。
+# ⚠ 会停/起正式 dsh web —— 由用户在 SSH 终端手动执行（agent 不自启）。
+#
+# 用法：sudo bash <仓库根目录>/访问门禁/restore-formal-auth.sh
+set -uo pipefail
+
+OLD_PROJECT="<仓库根目录>/全网监听与登录鉴权"
+PROFILE="/root/.dsh/profiles/web"
+PATCH="$PROFILE/cordis.patch.yml"
+
+echo "== [1/4] 停正式 dsh web（避免配置热重载把会话搞崩）=="
+pkill -f "/usr/bin/dsh web" 2>/dev/null && sleep 3 || true
+sleep 1
+ss -tlnp 2>/dev/null | grep -q "127.0.0.1:3080 " && { echo "  仍有关联进程，强制结束"; pkill -9 -f "/usr/bin/dsh web" 2>/dev/null || true; sleep 2; }
+
+echo "== [2/4] 移除新插件目录，恢复旧插件目录 =="
+rm -rf "$PROFILE/node_modules/dsh-host-access-gate" "$PROFILE/node_modules/dsh-client-ui-access-gate"
+echo "  已删除新插件目录（dsh-host-access-gate / dsh-client-ui-access-gate）"
+mkdir -p "$PROFILE/node_modules"
+cp -a "$OLD_PROJECT/dsh-web-auth" "$PROFILE/node_modules/dsh-web-auth"
+cp -a "$OLD_PROJECT/dsh-client-ui-web-auth" "$PROFILE/node_modules/dsh-client-ui-web-auth"
+echo "  已恢复旧插件目录（dsh-web-auth / dsh-client-ui-web-auth）"
+
+echo "== [3/4] 还原 cordis.patch.yml（移除 access-gate 行，恢复 web-auth 行）=="
+[ -f "$PATCH" ] || { echo "  错误：找不到 $PATCH"; exit 1; }
+node -e '
+const { createRequire } = require("node:module");
+const fs = require("node:fs");
+const req = createRequire("/usr/lib/node_modules/@deepseek-ai/dsh/package.json");
+const yaml = req("js-yaml");
+const { entryListSchema } = req("@deepseek-ai/cordis-plugin-include");
+const file = process.argv[1];
+const current = yaml.load(fs.readFileSync(file, "utf8"), { schema: entryListSchema });
+if (!Array.isArray(current)) { console.error("patch 不是数组，中止"); process.exit(2); }
+const NEW_IDS = new Set(["access-gate", "ui-access-gate"]);
+const LEGACY = [
+  { id: "web-auth", name: "dsh-web-auth", inject: ["webServer"], config: { password: { __jsExpr: "process.env.DSH_WEB_PASSWORD" }, mode: "on" } },
+  { id: "ui-web-auth", name: "dsh-client-ui-web-auth" },
+];
+let removed = 0;
+for (const e of current) {
+  if (e && Array.isArray(e.insert)) {
+    const before = e.insert.length;
+    e.insert = e.insert.filter((i) => !(i && NEW_IDS.has(i.id)));
+    removed += before - e.insert.length;
+  }
+}
+const cleaned = current.filter((e) => !(e && typeof e.id === "string" && NEW_IDS.has(e.id)));
+const insert = cleaned.find((e) => e && Array.isArray(e.insert));
+if (insert) {
+  for (const row of LEGACY) {
+    if (!insert.insert.some((i) => i && i.id === row.id)) insert.insert.push(row);
+  }
+} else {
+  cleaned.push({ insert: LEGACY });
+}
+const header = "# 本文件由 install-auth-plugin.mjs 管理（首次写入时备份为 cordis.patch.yml.bak）。\n# 项目：全网监听与登录鉴权。手动编辑请保留下列条目结构；重跑安装脚本会幂等跳过。\n";
+fs.writeFileSync(file, header + yaml.dump(cleaned, { schema: entryListSchema, noRefs: true, lineWidth: 120 }));
+console.log("  已还原 patch：移除 " + removed + " 行新条目，恢复 web-auth / ui-web-auth 挂载行");
+' "$PATCH" || exit 1
+
+echo "== [4/4] 按原方式重启正式 dsh web =="
+cd /
+nohup node /usr/bin/dsh web --trusted-host 192.168.1.100 > /tmp/dsh-web.log 2>&1 &
+for i in $(seq 1 60); do
+  grep -q "dsh web:" /tmp/dsh-web.log 2>/dev/null && break
+  sleep 1
+done
+tail -5 /tmp/dsh-web.log
+
+echo
+echo "还原完成。验证："
+echo "  bash <仓库根目录>/全网监听与登录鉴权/verify.sh --live"
+echo "（口令未变：/root/.dsh/settings.yaml 中 web-auth.password；重启用旧会话失效属正常）"

